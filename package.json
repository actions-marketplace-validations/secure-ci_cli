{
  "name": "@secureci/cli",
  "version": "1.2.0",
  "description": "SecureCI: validate, check against pipeline standards, and run GitHub Actions workflows locally",
  "main": "dist/index.js",
  "bin": {
    "secureci": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:sea": "node scripts/build-sea.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "format": "prettier --write .",
    "prepare": "npm run build"
  },
  "keywords": [
    "github-actions",
    "workflow",
    "ci",
    "cli",
    "security",
    "policy-as-code",
    "secureci"
  ],
  "author": {
    "name": "SecureCI",
    "email": "hello@secure-ci.dev"
  },
  "contributors": [
    {
      "name": "Jabran Rafique",
      "email": "hello@jabran.me"
    }
  ],
  "license": "MIT",
  "homepage": "https://secure-ci.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secure-ci/cli.git"
  },
  "bugs": {
    "url": "https://github.com/secure-ci/cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": "@jabraf/prettier",
  "dependencies": {
    "commander": "^11.1.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jabraf/prettier": "^3.0.1",
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "volta": {
    "node": "24.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
