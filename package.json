{
  "name": "actly",
  "version": "0.1.3",
  "description": "Validate and test GitHub actions and workflows locally",
  "main": "dist/index.js",
  "bin": {
    "actly": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "prepare": "npm run build"
  },
  "keywords": [
    "github-actions",
    "workflow",
    "test",
    "cli",
    "actly"
  ],
  "author": {
    "name": "Jabran Rafique",
    "email": "hello@jabran.me"
  },
  "license": "MIT",
  "prettier": "@jabraf/prettier",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@jabraf/dev": "^0.1.4",
    "@jabraf/prettier": "^3.0.1",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "volta": {
    "node": "24.0.0"
  }
}
